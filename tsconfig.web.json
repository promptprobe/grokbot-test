{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": []
  },
  "include": [
    "src/web/**/*.ts",
    "src/core/**/*.ts",
    "src/providers/**/*.ts",
    "src/check.ts",
    "src/diagnose.ts",
    "src/vector.ts"
  ]
}
